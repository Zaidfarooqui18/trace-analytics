# ==========================================
# TRACE ANALYTICS - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Option 1: MongoDB Atlas (Recommended for cloud deployment):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/trace_analytics?retryWrites=true&w=majority
# Option 2: Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/trace_analytics
# Option 3: Leave blank or omit in development to use the automatic built-in in-memory MongoDB!
MONGODB_URI=

# CORS Permitted Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000
