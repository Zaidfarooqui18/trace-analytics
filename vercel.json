{
  "version": 2,
  "buildCommand": "npm run build:all",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/tracker.js",
      "destination": "/tracker.js"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/demo/$1"
    },
    {
      "source": "/((?!api|demo|tracker\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
